import { Button, LineEdit, CheckBox, ComboBox, ListView, ScrollView, ProgressIndicator, Spinner, Palette } from "std-widgets.slint";

export struct ServerItem {
    name: string,
    endpoint: string,
}

// A match in the editor, in byte offsets; start is -1 when there is none.
export struct FindRange {
    start: int,
    end: int,
}

export struct FileEntry {
    name: string,
    is-dir: bool,
    is-image: bool,
    is-hidden: bool,
    size: string,
    modified: string,
    selected: bool,
}

component Modal inherits Rectangle {
    in property <string> title;
    in property <length> box-width: 440px;
    background: #000000a0;

    // Swallows clicks so the window behind is inert.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.box-width;
                background: Palette.background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: root.title;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    @children
                }
            }
        }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> secret;
    in-out property <string> value;
    spacing: 8px;
    Text {
        text: root.label;
        width: 110px;
        vertical-alignment: center;
    }

    LineEdit {
        text <=> root.value;
        placeholder-text: root.hint;
        input-type: root.secret ? InputType.password : InputType.text;
    }
}

// Clickable column title. The arrow shows the sort direction.
component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> descending;
    in property <bool> align-right;
    callback clicked();
    background: ta.has-hover ? Palette.control-background : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: root.align-right ? end : start;
        spacing: 4px;
        Text {
            text: root.title;
            vertical-alignment: center;
            font-weight: 600;
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/up.svg");
                colorize: Palette.foreground;
                width: 12px;
                height: 12px;
                opacity: root.active ? 1 : 0;
                transform-rotation: root.descending ? 180deg : 0deg;
            }
        }
    }
}

// Shared state of the single tooltip drawn on top of the window.
global Tip {
    in-out property <string> text;
    // Point the tooltip hangs from: bottom centre of the hovered button.
    in-out property <length> x;
    in-out property <length> y;
}

// Button that shows only an icon; its label appears as a tooltip on hover.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();
    property <bool> hovered: hover.has-hover;
    horizontal-stretch: 0;

    changed hovered => {
        if (!self.hovered && Tip.text == root.tooltip) {
            Tip.text = "";
        }
    }

    HorizontalLayout {
        // Wraps the button only to observe hover; clicks reach the button.
        hover := TouchArea {
            Button {
                icon: root.icon;
                colorize-icon: true;
                enabled: root.enabled;
                clicked => {
                    Tip.text = "";
                    root.clicked();
                }
            }
        }
    }

    // Short delay, so the tooltip does not flash while the pointer passes by.
    Timer {
        interval: 500ms;
        running: root.hovered;
        triggered => {
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.text = root.tooltip;
        }
    }
}

component EntryIcon inherits Rectangle {
    in property <bool> is-dir;
    width: 16px;
    height: 16px;
    Rectangle {
        width: root.is-dir ? 16px : 12px;
        height: root.is-dir ? 12px : 16px;
        border-radius: 2px;
        background: root.is-dir ? #e0a030 : transparent;
        border-width: root.is-dir ? 0px : 1.5px;
        border-color: Palette.foreground;
        opacity: root.is-dir ? 1 : 0.6;
    }
}

export component MainWindow inherits Window {
    title: "Filestasher";
    preferred-width: 1420px;
    preferred-height: 660px;
    min-width: 760px;
    min-height: 440px;

    // Servers
    in property <[ServerItem]> servers;
    in-out property <int> selected-server: -1;
    in-out property <bool> sidebar-open: true;
    callback connect-server(int);
    callback add-server();
    callback edit-server(int);
    callback delete-server(int);
    callback duplicate-server(int);

    // Tabs
    in property <[string]> tabs;
    in property <int> active-tab: -1;
    callback select-tab(int);
    callback close-tab(int);

    // Active tab view
    in-out property <string> location;
    // A location typed into the bar and confirmed with Enter.
    callback go-to(string);
    in property <[FileEntry]> entries;
    in property <string> status;
    in property <bool> busy;
    in property <bool> in-bucket;
    in property <bool> can-go-up;
    in property <bool> has-more;
    in-out property <bool> search-open;
    in-out property <string> search-text;
    in property <string> search-info;
    callback search-changed(string);
    // 0 = name, 1 = size, 2 = modified
    in property <int> sort-column: 2;
    in property <bool> sort-descending: true;
    callback sort-by(int);
    callback load-more();
    callback go-up();
    callback refresh();
    callback upload();
    callback download();
    // Downloads the selection into the local pane's folder, without asking.
    callback download-local();
    callback delete-selected();
    callback create-folder(string);
    callback row-clicked(int, bool);
    // Shift+click: selects from the last clicked row to this one.
    callback row-range(int);
    callback ask-rename();
    callback rename(string);
    // Enter: opens the one selected row; true = in the local pane.
    callback activate-selected(bool);
    // The pane that was clicked last gets the keyboard shortcuts.
    property <bool> keys-local;
    callback row-activated(int);
    callback row-context(int);
    // Copies the paths of the selected rows; true = as s3:// URIs.
    callback copy-path(bool);

    // Puts text on the system clipboard, through a hidden text input.
    public function copy-to-clipboard(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }

    // Local folder pane
    in-out property <bool> local-open: true;
    in property <string> local-path;
    in property <string> local-status;
    in property <[FileEntry]> local-entries;
    callback local-up();
    callback local-refresh();
    callback local-choose();
    callback local-row-clicked(int, bool);
    callback local-row-range(int);
    callback local-row-context(int);
    callback local-row-activated(int);
    in property <int> local-sort-column: 2;
    in property <bool> local-sort-descending: true;
    callback local-sort-by(int);

    // Drag and drop between the S3 list and the local pane
    in property <string> drag-label;
    // Sets drag-label for the rows about to be dragged; true = local rows.
    callback drag-started(bool);
    // A drag ended over the other pane; true = local rows dropped on S3.
    callback dropped(bool);
    property <bool> drag-active;
    property <bool> drag-from-local;
    property <length> drag-x;
    property <length> drag-y;
    // The remote and local lists start equally wide: half of the room next
    // to the servers panel each, until the divider is dragged. Set from
    // change handlers because a binding on the window width would loop
    // through the layout. The start value fits the preferred window size.
    property <length> local-width: (1420px - 28px - 230px) / 2;
    property <bool> local-auto: true;
    function balance() {
        if (root.local-auto) {
            root.local-width = max(root.panel-min, (root.width - 28px - (root.sidebar-open ? root.sidebar-width : 0px)) / 2);
        }
    }
    changed width => {
        root.balance();
    }
    changed sidebar-open => {
        root.balance();
    }
    changed sidebar-width => {
        root.balance();
    }
    // Column widths of the local pane grow with it, so a wider pane does not
    // give all the extra room to the name column.
    property <length> local-size-col: max(72px, root.local-width * 0.17);
    property <length> local-modified-col: max(118px, root.local-width * 0.28);
    // Left edges of the S3 area and of the local pane with its handle.
    property <length> main-left: (root.sidebar-open ? root.sidebar-width : 0px) + 14px;
    // Panel widths, changed by dragging the handles. Each panel may grow
    // until the file list in the middle is down to its minimum.
    property <length> sidebar-width: 230px;
    property <length> panel-min: 160px;
    property <length> middle-min: 420px;
    property <length> sidebar-max: max(root.panel-min, root.width - 28px - root.middle-min - (root.local-open ? root.local-width : 0px));
    property <length> local-max: max(root.panel-min, root.width - 28px - root.middle-min - (root.sidebar-open ? root.sidebar-width : 0px));
    property <length> local-left: root.width - 14px - (root.local-open ? root.local-width : 0px);
    property <bool> over-local: root.drag-active && !root.drag-from-local && root.local-open && root.drag-x >= root.width - root.local-width;
    property <bool> over-remote: root.drag-active && root.drag-from-local && root.in-bucket && root.drag-x >= root.main-left && root.drag-x < root.local-left;

    function end-drag() {
        if (root.drag-active) {
            if (root.over-local) {
                root.dropped(false);
            } else if (root.over-remote) {
                root.dropped(true);
            }
            root.drag-active = false;
        }
    }

    // Transfers
    in property <int> transfer-count;
    in property <float> transfer-progress;
    in property <string> transfer-text;

    // Server dialog
    in-out property <bool> server-dialog-open;
    in property <string> server-dialog-title;
    in-out property <string> form-name;
    in-out property <string> form-endpoint;
    in-out property <string> form-region;
    in-out property <string> form-access-key;
    in-out property <string> form-secret-key;
    in-out property <string> form-bucket;
    in-out property <bool> form-path-style;
    // 0 = S3, 1 = SFTP, 2 = FTP.
    in-out property <int> form-protocol;
    property <bool> form-s3: root.form-protocol == 0;
    property <bool> form-sftp: root.form-protocol == 1;
    in-out property <string> form-host;
    in-out property <string> form-password;
    in-out property <string> form-key-file;
    in-out property <string> form-jump;
    in-out property <string> form-jump-password;
    in property <string> form-message;
    callback save-server();
    callback test-server();
    callback browse-key-file();

    // Image preview
    in-out property <bool> preview-open;
    in property <string> preview-title;
    in property <string> preview-info;
    in property <string> preview-message;
    in property <image> preview-image;

    // Overwrite question: 0 overwrite, 1 skip existing, 2 cancel
    in-out property <bool> conflict-open;
    in property <string> conflict-text;
    callback conflict-choice(int);

    // Confirm dialog
    in-out property <bool> confirm-open;
    in property <string> confirm-text;
    in property <string> confirm-title: "Confirm delete";
    // Label of the button that says yes.
    in property <string> confirm-action: "Delete";
    callback confirm-accepted();
    callback confirm-rejected();
    callback cancel-transfers();

    // Text editor
    in-out property <bool> editor-open;
    in property <string> editor-name;
    in property <string> editor-path;
    in property <string> editor-font;
    in-out property <string> editor-text;
    // The line numbers, one per line.
    in property <string> editor-lines;
    in property <bool> editor-dirty;
    in property <bool> editor-read-only;
    in property <string> editor-message;
    // The question about unsaved changes.
    in-out property <bool> editor-close-open;
    callback editor-edited(string);
    // Asks before overwriting; true = close the editor afterwards.
    callback editor-save(bool);
    callback editor-close();
    callback editor-discard();
    // Text, what to look for, where to start, forward or backward.
    callback editor-find(string, string, int, bool) -> FindRange;

    // New folder dialog
    in-out property <bool> newfolder-open;
    in-out property <string> newfolder-name;
    // The dialog renames the selected entry instead of creating a folder.
    in-out property <bool> renaming;

    clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }

    // Keyboard shortcuts of the file lists. Focused by a click on a row, so
    // keys typed into a text field never land here.
    keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(ev) => {
            if (root.preview-open && ev.text == Key.Escape) {
                root.preview-open = false;
                return accept;
            }
            if (root.editor-open || root.server-dialog-open || root.newfolder-open || root.conflict-open || root.confirm-open || root.preview-open) {
                return reject;
            }
            if (ev.text == Key.F5) {
                if (root.keys-local) {
                    root.local-refresh();
                } else {
                    root.refresh();
                }
            } else if (ev.text == Key.Backspace) {
                if (root.keys-local) {
                    root.local-up();
                } else if (root.can-go-up) {
                    root.go-up();
                }
            } else if (ev.text == Key.Return) {
                root.activate-selected(root.keys-local);
            } else if (ev.text == Key.Delete && !root.keys-local && root.in-bucket) {
                root.delete-selected();
            } else if (ev.text == Key.F2 && !root.keys-local && root.in-bucket) {
                root.ask-rename();
            } else {
                return reject;
            }
            return accept;
        }
    }

    HorizontalLayout {
        // Sidebar
        if root.sidebar-open: Rectangle {
            width: root.sidebar-width;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text {
                    text: "Servers";
                    font-weight: 700;
                }

                ListView {
                    vertical-stretch: 1;
                    for s[i] in root.servers: Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: i == root.selected-server ? Palette.selection-background : sta.has-hover ? Palette.control-background : transparent;
                        sta := TouchArea {
                            clicked => {
                                root.selected-server = i;
                            }
                            double-clicked => {
                                root.selected-server = i;
                                root.connect-server(i);
                            }
                        }

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: s.name;
                                overflow: elide;
                                color: i == root.selected-server ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: s.endpoint;
                                font-size: 11px;
                                overflow: elide;
                                opacity: 0.7;
                                color: i == root.selected-server ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                    }
                }

                Button {
                    text: "Connect";
                    icon: @image-url("icons/connect.svg");
                    colorize-icon: true;
                    primary: true;
                    enabled: root.selected-server >= 0;
                    clicked => {
                        root.connect-server(root.selected-server);
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: "Add";
                        icon: @image-url("icons/add.svg");
                        colorize-icon: true;
                        clicked => {
                            root.add-server();
                        }
                    }

                    Button {
                        text: "Duplicate";
                        enabled: root.selected-server >= 0;
                        clicked => {
                            root.duplicate-server(root.selected-server);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: "Edit";
                        icon: @image-url("icons/edit.svg");
                        colorize-icon: true;
                        enabled: root.selected-server >= 0;
                        clicked => {
                            root.edit-server(root.selected-server);
                        }
                    }

                    Button {
                        text: "Delete";
                        icon: @image-url("icons/trash.svg");
                        colorize-icon: true;
                        enabled: root.selected-server >= 0;
                        clicked => {
                            root.delete-server(root.selected-server);
                        }
                    }
                }
            }
        }

        // Handle that hides or shows the sidebar
        Rectangle {
            width: 14px;
            background: hta.has-hover ? Palette.control-background : Palette.alternate-background;
            Text {
                text: root.sidebar-open ? "‹" : "›";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 16px;
            }

            // Click toggles the panel, dragging resizes it.
            hta := TouchArea {
                property <bool> dragged;
                property <length> press-x;
                property <length> pointer-x: self.absolute-position.x + self.mouse-x;
                mouse-cursor: root.sidebar-open ? col-resize : pointer;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.dragged = false;
                        self.press-x = self.pointer-x;
                    }
                }
                moved => {
                    if (self.pressed && root.sidebar-open) {
                        if (abs((self.pointer-x - self.press-x) / 1px) > 3) {
                            self.dragged = true;
                        }
                        if (self.dragged) {
                            root.sidebar-width = max(root.panel-min, min(root.sidebar-max, self.pointer-x - 7px));
                        }
                    }
                }
                clicked => {
                    if (!self.dragged) {
                        root.sidebar-open = !root.sidebar-open;
                    }
                }
            }
        }

        // Main area
        VerticalLayout {
            horizontal-stretch: 1;

            if root.active-tab < 0: Text {
                text: "Double-click a server to connect.\nEach connection opens in its own tab.";
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
                opacity: 0.6;
            }

            // Tab bar
            if root.active-tab >= 0: Rectangle {
                height: 34px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    alignment: start;
                    for t[i] in root.tabs: Rectangle {
                        background: i == root.active-tab ? Palette.background : tta.has-hover ? Palette.control-background : transparent;
                        tta := TouchArea {
                            clicked => {
                                root.select-tab(i);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 6px;
                            Text {
                                text: t;
                                vertical-alignment: center;
                                max-width: 170px;
                                overflow: elide;
                                font-weight: i == root.active-tab ? 600 : 400;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: cta.has-hover ? #88888866 : transparent;
                                    Text {
                                        text: "×";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    cta := TouchArea {
                                        clicked => {
                                            root.close-tab(i);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Toolbar
            if root.active-tab >= 0: HorizontalLayout {
                padding: 6px;
                spacing: 6px;
                IconButton {
                    icon: @image-url("icons/up.svg");
                    tooltip: "Up";
                    enabled: root.can-go-up;
                    clicked => {
                        root.go-up();
                    }
                }

                IconButton {
                    icon: @image-url("icons/refresh.svg");
                    tooltip: "Refresh";
                    clicked => {
                        root.refresh();
                    }
                }

                LineEdit {
                    text <=> root.location;
                    horizontal-stretch: 1;
                    accepted(text) => {
                        root.go-to(text);
                        keys.focus();
                    }
                }

                if root.search-open: Text {
                    text: root.search-info;
                    vertical-alignment: center;
                    opacity: 0.7;
                }

                if root.search-open: LineEdit {
                    width: 200px;
                    placeholder-text: "Search this folder";
                    text <=> root.search-text;
                    init => {
                        self.focus();
                    }
                    edited(text) => {
                        root.search-changed(text);
                    }
                }

                if root.search-open: IconButton {
                    icon: @image-url("icons/close.svg");
                    tooltip: "Close search";
                    clicked => {
                        root.search-open = false;
                        root.search-text = "";
                        root.search-changed("");
                    }
                }

                if !root.search-open: IconButton {
                    icon: @image-url("icons/search.svg");
                    tooltip: "Search";
                    clicked => {
                        root.search-open = true;
                    }
                }

                IconButton {
                    icon: @image-url("icons/upload.svg");
                    tooltip: "Upload";
                    enabled: root.in-bucket;
                    clicked => {
                        root.upload();
                    }
                }

                IconButton {
                    icon: @image-url("icons/download.svg");
                    tooltip: "Download";
                    enabled: root.in-bucket;
                    clicked => {
                        root.download();
                    }
                }

                IconButton {
                    icon: @image-url("icons/folder-plus.svg");
                    tooltip: "New Folder";
                    enabled: root.in-bucket;
                    clicked => {
                        root.newfolder-name = "";
                        root.renaming = false;
                        root.newfolder-open = true;
                    }
                }

                IconButton {
                    icon: @image-url("icons/trash.svg");
                    tooltip: "Delete";
                    enabled: root.in-bucket;
                    clicked => {
                        root.delete-selected();
                    }
                }
            }

            // Column header
            if root.active-tab >= 0: Rectangle {
                height: 26px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 24px;
                    spacing: 8px;
                    Rectangle {
                        width: 16px;
                    }

                    HeaderCell {
                        title: "Name";
                        horizontal-stretch: 1;
                        active: root.sort-column == 0;
                        descending: root.sort-descending;
                        clicked => {
                            root.sort-by(0);
                        }
                    }

                    HeaderCell {
                        title: "Size";
                        width: 90px;
                        align-right: true;
                        active: root.sort-column == 1;
                        descending: root.sort-descending;
                        clicked => {
                            root.sort-by(1);
                        }
                    }

                    HeaderCell {
                        title: "Modified";
                        width: 140px;
                        active: root.sort-column == 2;
                        descending: root.sort-descending;
                        clicked => {
                            root.sort-by(2);
                        }
                    }
                }
            }

            if root.active-tab >= 0: ListView {
                vertical-stretch: 1;
                // Lazy loading: ask for the next page near the end of the list.
                changed content-y => {
                    if (root.has-more && !root.busy && self.visible-height - self.content-y >= self.content-height - 600px) {
                        root.load-more();
                    }
                }
                for entry[i] in root.entries: Rectangle {
                    height: 28px;
                    background: entry.selected ? Palette.selection-background : rta.has-hover ? Palette.alternate-background : transparent;
                    cma := ContextMenuArea {
                        Menu {
                            if entry.is-dir: MenuItem {
                                title: "Open";
                                activated => {
                                    root.row-activated(i);
                                }
                            }
                            if entry.is-image: MenuItem {
                                title: "Preview";
                                activated => {
                                    root.row-activated(i);
                                }
                            }
                            MenuItem {
                                title: "Copy Path";
                                activated => {
                                    root.copy-path(false);
                                }
                            }
                            MenuItem {
                                title: "Copy S3 URI";
                                activated => {
                                    root.copy-path(true);
                                }
                            }
                            MenuItem {
                                title: "Rename";
                                enabled: root.in-bucket;
                                activated => {
                                    root.ask-rename();
                                }
                            }
                            MenuItem {
                                title: "Download";
                                enabled: root.in-bucket;
                                activated => {
                                    root.download-local();
                                }
                            }
                        }
                    }

                    rta := TouchArea {
                        property <bool> ctrl-down;
                        property <bool> dragged;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                self.ctrl-down = ev.modifiers.control || ev.modifiers.shift;
                                self.dragged = false;
                                root.drag-active = false;
                                root.keys-local = false;
                                keys.focus();
                                // A plain press keeps a selection that contains the
                                // row, so several rows can be dragged together.
                                if (ev.modifiers.shift) {
                                    root.row-range(i);
                                } else if (ev.modifiers.control) {
                                    root.row-clicked(i, true);
                                } else {
                                    root.row-context(i);
                                }
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                // Selects the row unless it is already part of the selection.
                                root.row-context(i);
                                cma.show({ x: self.mouse-x, y: self.mouse-y });
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                root.end-drag();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.drag-x = self.absolute-position.x + self.mouse-x;
                                root.drag-y = self.absolute-position.y + self.mouse-y;
                                if (!self.dragged && root.in-bucket && (abs((self.mouse-x - self.pressed-x) / 1px) > 8 || abs((self.mouse-y - self.pressed-y) / 1px) > 8)) {
                                    self.dragged = true;
                                    root.drag-from-local = false;
                                    root.drag-started(false);
                                    root.drag-active = true;
                                }
                            }
                        }
                        clicked => {
                            if (!self.ctrl-down && !self.dragged) {
                                root.row-clicked(i, false);
                            }
                        }
                        double-clicked => {
                            root.row-activated(i);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            EntryIcon {
                                is-dir: entry.is-dir;
                            }
                        }

                        Text {
                            text: entry.name;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                            color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: entry.size;
                            width: 90px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: entry.modified;
                            width: 140px;
                            vertical-alignment: center;
                            color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                        }
                    }
                }
            }

            // Status bar
            Rectangle {
                height: 28px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    if root.busy: VerticalLayout {
                        alignment: center;
                        Spinner {
                            width: 16px;
                            height: 16px;
                            indeterminate: true;
                        }
                    }
                    Text {
                        text: root.status;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.transfer-count > 0: Text {
                        text: root.transfer-text;
                        vertical-alignment: center;
                    }
                    if root.transfer-count > 0: VerticalLayout {
                        alignment: center;
                        ProgressIndicator {
                            width: 140px;
                            progress: root.transfer-progress;
                        }
                    }
                    if root.transfer-count > 0: Button {
                        text: "Cancel";
                        icon: @image-url("icons/close.svg");
                        colorize-icon: true;
                        clicked => {
                            root.cancel-transfers();
                        }
                    }
                }
            }
        }

        // Handle that hides or shows the local pane
        Rectangle {
            width: 14px;
            background: lha.has-hover ? Palette.control-background : Palette.alternate-background;
            Text {
                text: root.local-open ? "›" : "‹";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 16px;
            }

            // Click toggles the pane, dragging resizes it.
            lha := TouchArea {
                property <bool> dragged;
                property <length> press-x;
                property <length> pointer-x: self.absolute-position.x + self.mouse-x;
                mouse-cursor: root.local-open ? col-resize : pointer;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        self.dragged = false;
                        self.press-x = self.pointer-x;
                    }
                }
                moved => {
                    if (self.pressed && root.local-open) {
                        if (abs((self.pointer-x - self.press-x) / 1px) > 3) {
                            self.dragged = true;
                        }
                        if (self.dragged) {
                            root.local-auto = false;
                            root.local-width = max(root.panel-min, min(root.local-max, root.width - self.pointer-x - 7px));
                        }
                    }
                }
                clicked => {
                    if (!self.dragged) {
                        root.local-open = !root.local-open;
                    }
                }
            }
        }

        // Local folder pane
        if root.local-open: Rectangle {
            width: root.local-width;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Local";
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: @image-url("icons/up.svg");
                        tooltip: "Up";
                        clicked => {
                            root.local-up();
                        }
                    }

                    IconButton {
                        icon: @image-url("icons/refresh.svg");
                        tooltip: "Refresh";
                        clicked => {
                            root.local-refresh();
                        }
                    }

                    IconButton {
                        icon: @image-url("icons/folder.svg");
                        tooltip: "Choose folder";
                        clicked => {
                            root.local-choose();
                        }
                    }
                }

                Text {
                    text: root.local-path;
                    font-size: 11px;
                    overflow: elide;
                    opacity: 0.7;
                }

                // Column header
                HorizontalLayout {
                    height: 24px;
                    padding-left: 6px;
                    padding-right: 22px;
                    spacing: 8px;
                    Rectangle {
                        width: 16px;
                    }

                    HeaderCell {
                        title: "Name";
                        horizontal-stretch: 1;
                        active: root.local-sort-column == 0;
                        descending: root.local-sort-descending;
                        clicked => {
                            root.local-sort-by(0);
                        }
                    }

                    HeaderCell {
                        title: "Size";
                        width: root.local-size-col;
                        align-right: true;
                        active: root.local-sort-column == 1;
                        descending: root.local-sort-descending;
                        clicked => {
                            root.local-sort-by(1);
                        }
                    }

                    HeaderCell {
                        title: "Modified";
                        width: root.local-modified-col;
                        active: root.local-sort-column == 2;
                        descending: root.local-sort-descending;
                        clicked => {
                            root.local-sort-by(2);
                        }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for entry[i] in root.local-entries: Rectangle {
                        height: 26px;
                        border-radius: 3px;
                        background: entry.selected ? Palette.selection-background : lta.has-hover ? Palette.control-background : transparent;
                        lcma := ContextMenuArea {
                            Menu {
                                if entry.is-dir: MenuItem {
                                    title: "Open";
                                    activated => {
                                        root.local-row-activated(i);
                                    }
                                }
                                if entry.is-image: MenuItem {
                                    title: "Preview";
                                    activated => {
                                        root.local-row-activated(i);
                                    }
                                }
                                MenuItem {
                                    title: "Upload";
                                    enabled: root.in-bucket;
                                    activated => {
                                        root.dropped(true);
                                    }
                                }
                            }
                        }

                        lta := TouchArea {
                            property <bool> ctrl-down;
                            property <bool> dragged;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    self.ctrl-down = ev.modifiers.control || ev.modifiers.shift;
                                    self.dragged = false;
                                    root.drag-active = false;
                                    root.keys-local = true;
                                    keys.focus();
                                    if (ev.modifiers.shift) {
                                        root.local-row-range(i);
                                    } else if (ev.modifiers.control) {
                                        root.local-row-clicked(i, true);
                                    } else {
                                        root.local-row-context(i);
                                    }
                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                    root.local-row-context(i);
                                    lcma.show({ x: self.mouse-x, y: self.mouse-y });
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    root.end-drag();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-x = self.absolute-position.x + self.mouse-x;
                                    root.drag-y = self.absolute-position.y + self.mouse-y;
                                    if (!self.dragged && (abs((self.mouse-x - self.pressed-x) / 1px) > 8 || abs((self.mouse-y - self.pressed-y) / 1px) > 8)) {
                                        self.dragged = true;
                                        root.drag-from-local = true;
                                        root.drag-started(true);
                                        root.drag-active = true;
                                    }
                                }
                            }
                            clicked => {
                                if (!self.ctrl-down && !self.dragged) {
                                    root.local-row-clicked(i, false);
                                }
                            }
                            double-clicked => {
                                root.local-row-activated(i);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                EntryIcon {
                                    is-dir: entry.is-dir;
                                }
                            }

                            Text {
                                text: entry.name;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: entry.size;
                                width: root.local-size-col;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: entry.modified;
                                width: root.local-modified-col;
                                vertical-alignment: center;
                                overflow: elide;
                                color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                    }
                }

                Text {
                    text: root.local-status;
                    font-size: 11px;
                    overflow: elide;
                    opacity: 0.7;
                }
            }
        }
    }

    // Drop target highlight while dragging
    if root.over-local || root.over-remote: Rectangle {
        x: root.over-local ? root.width - root.local-width : root.main-left;
        y: 0px;
        width: root.over-local ? root.local-width : root.local-left - root.main-left;
        height: root.height;
        border-width: 2px;
        border-color: Palette.accent-background;
        background: #4080ff22;
    }

    if root.preview-open: Rectangle {
        background: #000000e0;

        // Click anywhere to close.
        TouchArea {
            clicked => {
                root.preview-open = false;
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.preview-title;
                    color: white;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.preview-info;
                    color: #cccccc;
                    vertical-alignment: center;
                }

                Button {
                    text: "Close";
                    icon: @image-url("icons/close.svg");
                    colorize-icon: true;
                    clicked => {
                        root.preview-open = false;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // Shown at natural size, scaled down only when it does not fit.
                Image {
                    source: root.preview-image;
                    image-fit: contain;
                    width: min(parent.width, self.source.width * 1px);
                    height: min(parent.height, self.source.height * 1px);
                }

                Text {
                    text: root.preview-message;
                    color: white;
                    wrap: word-wrap;
                    width: min(parent.width, 520px);
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.server-dialog-open: Modal {
        title: root.server-dialog-title;
        box-width: 480px;
        Field {
            label: "Name";
            value <=> root.form-name;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Protocol";
                width: 110px;
                vertical-alignment: center;
            }

            ComboBox {
                horizontal-stretch: 1;
                model: ["S3", "SFTP (SSH)", "FTP"];
                current-index <=> root.form-protocol;
            }
        }

        if root.form-s3: Field {
            label: "Endpoint URL";
            hint: "https://… (blank for AWS)";
            value <=> root.form-endpoint;
        }

        if root.form-s3: Field {
            label: "Region";
            hint: "us-east-1";
            value <=> root.form-region;
        }

        if root.form-s3: Field {
            label: "Access key";
            value <=> root.form-access-key;
        }

        if root.form-s3: Field {
            label: "Secret key";
            secret: true;
            value <=> root.form-secret-key;
        }

        if root.form-s3: Field {
            label: "Default bucket";
            hint: "optional";
            value <=> root.form-bucket;
        }

        if root.form-s3: CheckBox {
            text: "Path-style addressing (MinIO, Ceph)";
            checked <=> root.form-path-style;
        }

        if !root.form-s3: Field {
            label: "Host";
            hint: "user@host:port";
            value <=> root.form-host;
        }

        if !root.form-s3: Field {
            label: "Password";
            hint: root.form-sftp ? "login password / key passphrase" : "login password";
            secret: true;
            value <=> root.form-password;
        }

        if root.form-sftp: HorizontalLayout {
            spacing: 6px;
            Field {
                horizontal-stretch: 1;
                label: "Key file";
                hint: "blank: ~/.ssh/id_ed25519, id_ecdsa, id_rsa";
                value <=> root.form-key-file;
            }

            Button {
                text: "Browse";
                clicked => {
                    root.browse-key-file();
                }
            }
        }

        if !root.form-s3: Field {
            label: "Start folder";
            hint: "blank: home folder";
            value <=> root.form-bucket;
        }

        if root.form-sftp: Field {
            label: "Jump host";
            hint: "optional, user@host:port (comma separated)";
            value <=> root.form-jump;
        }

        if root.form-sftp: Field {
            label: "Jump password";
            hint: "blank: same as password";
            secret: true;
            value <=> root.form-jump-password;
        }

        Text {
            text: root.form-message;
            wrap: word-wrap;
            min-height: 32px;
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: "Test Connection";
                icon: @image-url("icons/pulse.svg");
                colorize-icon: true;
                clicked => {
                    root.test-server();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.server-dialog-open = false;
                }
            }

            Button {
                text: "Save";
                icon: @image-url("icons/check.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    root.save-server();
                }
            }
        }
    }

    if root.editor-open: Rectangle {
        background: #000000a0;

        // Swallows clicks so the window behind is inert.
        TouchArea { }

        property <bool> find-missing;
        // Selects the next or previous match, starting at the selection.
        function find(forward: bool, from: int) {
            if (find-input.text == "") {
                self.find-missing = false;
                return;
            }
            let hit = root.editor-find(root.editor-text, find-input.text, from, forward);
            self.find-missing = hit.start < 0;
            if (hit.start >= 0) {
                editor-input.set-selection-offsets(hit.start, hit.end);
            }
        }
        function find-next() {
            find(true, max(editor-input.anchor-position-byte-offset, editor-input.cursor-position-byte-offset));
        }
        function find-previous() {
            find(false, min(editor-input.anchor-position-byte-offset, editor-input.cursor-position-byte-offset));
        }

        Rectangle {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: parent.height - 48px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            // The dot marks unsaved changes.
                            text: (root.editor-dirty ? "● " : "") + root.editor-name;
                            font-size: 16px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.editor-path;
                            font-size: 11px;
                            opacity: 0.7;
                            overflow: elide;
                        }
                    }

                    find-input := LineEdit {
                        width: 200px;
                        placeholder-text: "Find";
                        // Finds as you type, from the start of the selection.
                        edited => {
                            find(true, min(editor-input.anchor-position-byte-offset, editor-input.cursor-position-byte-offset));
                        }
                        accepted => {
                            find-next();
                        }
                        key-pressed(ev) => {
                            if (ev.text == Key.Escape) {
                                editor-input.focus();
                                return accept;
                            }
                            if (ev.text == Key.F3 || ev.text == Key.Return) {
                                if (ev.modifiers.shift) {
                                    find-previous();
                                } else {
                                    find-next();
                                }
                                return accept;
                            }
                            return reject;
                        }
                    }

                    Button {
                        text: "↑";
                        enabled: find-input.text != "";
                        clicked => {
                            find-previous();
                        }
                    }

                    Button {
                        text: "↓";
                        enabled: find-input.text != "";
                        clicked => {
                            find-next();
                        }
                    }

                    Button {
                        text: "Save";
                        icon: @image-url("icons/check.svg");
                        colorize-icon: true;
                        primary: true;
                        enabled: root.editor-dirty && !root.editor-read-only;
                        clicked => {
                            root.editor-save(false);
                        }
                    }

                    Button {
                        text: "Close";
                        icon: @image-url("icons/close.svg");
                        colorize-icon: true;
                        clicked => {
                            root.editor-close();
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.control-background;
                    HorizontalLayout {
                        padding: 1px;
                        // Line numbers: as wide as the largest one, and they
                        // follow the text up and down.
                        Rectangle {
                            width: numbers.preferred-width + 16px;
                            clip: true;
                            background: Palette.alternate-background;
                            numbers := Text {
                                x: 8px;
                                y: editor-scroll.content-y + 4px;
                                width: self.preferred-width;
                                text: root.editor-lines;
                                font-family: root.editor-font;
                                font-size: 13px;
                                horizontal-alignment: right;
                                opacity: 0.6;
                            }
                        }

                        editor-scroll := ScrollView {
                            horizontal-stretch: 1;
                            content-width: max(self.visible-width, editor-input.preferred-width + 16px);
                            content-height: max(self.visible-height, editor-input.preferred-height + 8px);
                            editor-input := TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.content-width - 16px;
                                height: parent.content-height - 8px;
                                text <=> root.editor-text;
                                single-line: false;
                                wrap: no-wrap;
                                font-family: root.editor-font;
                                font-size: 13px;
                                color: Palette.foreground;
                                page-height: editor-scroll.visible-height;
                                // A question on top takes the keyboard away.
                                read-only: root.editor-read-only || root.confirm-open || root.editor-close-open;
                                init => {
                                    self.focus();
                                }
                                edited => {
                                    root.editor-edited(self.text);
                                }
                                key-pressed(ev) => {
                                    if (root.confirm-open || root.editor-close-open) {
                                        return accept;
                                    }
                                    if (ev.modifiers.control && ev.text == "s") {
                                        root.editor-save(false);
                                        return accept;
                                    }
                                    if (ev.modifiers.control && ev.text == "f") {
                                        find-input.focus();
                                        find-input.select-all();
                                        return accept;
                                    }
                                    if (ev.text == Key.F3) {
                                        if (ev.modifiers.shift) {
                                            find-previous();
                                        } else {
                                            find-next();
                                        }
                                        return accept;
                                    }
                                    if (ev.text == Key.Escape) {
                                        root.editor-close();
                                        return accept;
                                    }
                                    return reject;
                                }
                                // Keeps the cursor in view, as TextEdit does.
                                cursor-position-changed(pos) => {
                                    if (pos.x + parent.content-x < 0px) {
                                        parent.content-x = min(0px, -pos.x);
                                    } else if (pos.x + parent.content-x > parent.visible-width - 24px) {
                                        parent.content-x = parent.visible-width - 24px - pos.x;
                                    }
                                    if (pos.y + parent.content-y < 0px) {
                                        parent.content-y = min(0px, -pos.y);
                                    } else if (pos.y + parent.content-y > parent.visible-height - 28px) {
                                        parent.content-y = parent.visible-height - 28px - pos.y;
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    text: find-missing ? "Not found: " + find-input.text : root.editor-message != "" ? root.editor-message : "Ctrl+S save · Ctrl+F find · F3 next · Shift+F3 previous · Esc close";
                    font-size: 11px;
                    opacity: 0.8;
                    overflow: elide;
                }
            }
        }
    }

    if root.editor-close-open: Modal {
        title: "Unsaved changes";
        box-width: 420px;
        Text {
            text: "Save the changes to " + root.editor-name + "?";
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.editor-close-open = false;
                }
            }

            Button {
                text: "Discard";
                icon: @image-url("icons/trash.svg");
                colorize-icon: true;
                clicked => {
                    root.editor-close-open = false;
                    root.editor-discard();
                }
            }

            Button {
                text: "Save";
                icon: @image-url("icons/check.svg");
                colorize-icon: true;
                primary: true;
                enabled: !root.editor-read-only;
                clicked => {
                    root.editor-close-open = false;
                    root.editor-save(true);
                }
            }
        }
    }

    if root.newfolder-open: Modal {
        title: root.renaming ? "Rename" : "New folder";
        box-width: 380px;
        function done() {
            root.newfolder-open = false;
            if (root.renaming) {
                root.rename(root.newfolder-name);
            } else {
                root.create-folder(root.newfolder-name);
            }
        }
        LineEdit {
            text <=> root.newfolder-name;
            placeholder-text: root.renaming ? "New name" : "Folder name";
            init => {
                self.focus();
            }
            accepted => {
                done();
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.newfolder-open = false;
                }
            }

            Button {
                text: root.renaming ? "Rename" : "Create";
                icon: root.renaming ? @image-url("icons/check.svg") : @image-url("icons/folder-plus.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    done();
                }
            }
        }
    }

    if root.conflict-open: Modal {
        title: "Files already exist";
        box-width: 480px;
        Text {
            text: root.conflict-text;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.conflict-open = false;
                    root.conflict-choice(2);
                }
            }

            Button {
                text: "Skip existing";
                clicked => {
                    root.conflict-open = false;
                    root.conflict-choice(1);
                }
            }

            Button {
                text: "Overwrite";
                primary: true;
                clicked => {
                    root.conflict-open = false;
                    root.conflict-choice(0);
                }
            }
        }
    }

    if root.confirm-open: Modal {
        title: root.confirm-title;
        box-width: 420px;
        Text {
            text: root.confirm-text;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.confirm-open = false;
                    root.confirm-rejected();
                }
            }

            Button {
                text: root.confirm-action;
                icon: root.confirm-action == "Delete" ? @image-url("icons/trash.svg") : @image-url("icons/check.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    root.confirm-open = false;
                    root.confirm-accepted();
                }
            }
        }
    }

    if root.drag-active: Rectangle {
        x: min(root.width - self.width - 4px, root.drag-x + 14px);
        y: min(root.height - self.height - 4px, root.drag-y + 14px);
        width: drag-text.preferred-width + 16px;
        height: drag-text.preferred-height + 8px;
        border-radius: 4px;
        background: Palette.accent-background;
        drag-text := Text {
            text: root.drag-label;
            color: Palette.accent-foreground;
        }
    }

    if Tip.text != "": Rectangle {
        x: max(4px, min(root.width - self.width - 4px, Tip.x - self.width / 2));
        y: Tip.y;
        width: tip-text.preferred-width + 16px;
        height: tip-text.preferred-height + 8px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.alternate-background;
        tip-text := Text {
            text: Tip.text;
            color: Palette.foreground;
        }
    }
}
