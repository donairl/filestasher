import { Button, LineEdit, CheckBox, ListView, ProgressIndicator, Spinner, Palette } from "std-widgets.slint";

export struct ServerItem {
    name: string,
    endpoint: string,
}

export struct FileEntry {
    name: string,
    is-dir: bool,
    is-image: bool,
    size: string,
    modified: string,
    selected: bool,
}

component Modal inherits Rectangle {
    in property <string> title;
    in property <length> box-width: 440px;
    background: #000000a0;

    // Swallows clicks so the window behind is inert.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.box-width;
                background: Palette.background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: root.title;
                        font-size: 16px;
                        font-weight: 600;
                    }

                    @children
                }
            }
        }
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> secret;
    in-out property <string> value;
    spacing: 8px;
    Text {
        text: root.label;
        width: 110px;
        vertical-alignment: center;
    }

    LineEdit {
        text <=> root.value;
        placeholder-text: root.hint;
        input-type: root.secret ? InputType.password : InputType.text;
    }
}

// Clickable column title. The arrow shows the sort direction.
component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    in property <bool> descending;
    in property <bool> align-right;
    callback clicked();
    background: ta.has-hover ? Palette.control-background : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: root.align-right ? end : start;
        spacing: 4px;
        Text {
            text: root.title;
            vertical-alignment: center;
            font-weight: 600;
        }

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/up.svg");
                colorize: Palette.foreground;
                width: 12px;
                height: 12px;
                opacity: root.active ? 1 : 0;
                transform-rotation: root.descending ? 180deg : 0deg;
            }
        }
    }
}

// Shared state of the single tooltip drawn on top of the window.
global Tip {
    in-out property <string> text;
    // Point the tooltip hangs from: bottom centre of the hovered button.
    in-out property <length> x;
    in-out property <length> y;
}

// Button that shows only an icon; its label appears as a tooltip on hover.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();
    property <bool> hovered: hover.has-hover;
    horizontal-stretch: 0;

    changed hovered => {
        if (!self.hovered && Tip.text == root.tooltip) {
            Tip.text = "";
        }
    }

    HorizontalLayout {
        // Wraps the button only to observe hover; clicks reach the button.
        hover := TouchArea {
            Button {
                icon: root.icon;
                colorize-icon: true;
                enabled: root.enabled;
                clicked => {
                    Tip.text = "";
                    root.clicked();
                }
            }
        }
    }

    // Short delay, so the tooltip does not flash while the pointer passes by.
    Timer {
        interval: 500ms;
        running: root.hovered;
        triggered => {
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height + 4px;
            Tip.text = root.tooltip;
        }
    }
}

component EntryIcon inherits Rectangle {
    in property <bool> is-dir;
    width: 16px;
    height: 16px;
    Rectangle {
        width: root.is-dir ? 16px : 12px;
        height: root.is-dir ? 12px : 16px;
        border-radius: 2px;
        background: root.is-dir ? #e0a030 : transparent;
        border-width: root.is-dir ? 0px : 1.5px;
        border-color: Palette.foreground;
        opacity: root.is-dir ? 1 : 0.6;
    }
}

export component MainWindow inherits Window {
    title: "S3 FStasher";
    preferred-width: 1320px;
    preferred-height: 660px;
    min-width: 760px;
    min-height: 440px;

    // Servers
    in property <[ServerItem]> servers;
    in-out property <int> selected-server: -1;
    in-out property <bool> sidebar-open: true;
    callback connect-server(int);
    callback add-server();
    callback edit-server(int);
    callback delete-server(int);

    // Tabs
    in property <[string]> tabs;
    in property <int> active-tab: -1;
    callback select-tab(int);
    callback close-tab(int);

    // Active tab view
    in property <string> location;
    in property <[FileEntry]> entries;
    in property <string> status;
    in property <bool> busy;
    in property <bool> in-bucket;
    in property <bool> has-more;
    in-out property <bool> search-open;
    in-out property <string> search-text;
    in property <string> search-info;
    callback search-changed(string);
    // 0 = name, 1 = size, 2 = modified
    in property <int> sort-column: 2;
    in property <bool> sort-descending: true;
    callback sort-by(int);
    callback load-more();
    callback go-up();
    callback refresh();
    callback upload();
    callback download();
    callback delete-selected();
    callback create-folder(string);
    callback row-clicked(int, bool);
    callback row-activated(int);
    callback row-context(int);
    // Copies the paths of the selected rows; true = as s3:// URIs.
    callback copy-path(bool);

    // Puts text on the system clipboard, through a hidden text input.
    public function copy-to-clipboard(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }

    // Local folder pane
    in-out property <bool> local-open: true;
    in property <string> local-path;
    in property <string> local-status;
    in property <[FileEntry]> local-entries;
    callback local-up();
    callback local-refresh();
    callback local-choose();
    callback local-row-clicked(int, bool);
    callback local-row-context(int);
    callback local-row-activated(int);

    // Drag and drop between the S3 list and the local pane
    in property <string> drag-label;
    // Sets drag-label for the rows about to be dragged; true = local rows.
    callback drag-started(bool);
    // A drag ended over the other pane; true = local rows dropped on S3.
    callback dropped(bool);
    property <bool> drag-active;
    property <bool> drag-from-local;
    property <length> drag-x;
    property <length> drag-y;
    property <length> local-width: 320px;
    // Left edges of the S3 area and of the local pane with its handle.
    property <length> main-left: (root.sidebar-open ? 230px : 0px) + 14px;
    property <length> local-left: root.width - 14px - (root.local-open ? root.local-width : 0px);
    property <bool> over-local: root.drag-active && !root.drag-from-local && root.local-open && root.drag-x >= root.width - root.local-width;
    property <bool> over-remote: root.drag-active && root.drag-from-local && root.in-bucket && root.drag-x >= root.main-left && root.drag-x < root.local-left;

    function end-drag() {
        if (root.drag-active) {
            if (root.over-local) {
                root.dropped(false);
            } else if (root.over-remote) {
                root.dropped(true);
            }
            root.drag-active = false;
        }
    }

    // Transfers
    in property <int> transfer-count;
    in property <float> transfer-progress;
    in property <string> transfer-text;

    // Server dialog
    in-out property <bool> server-dialog-open;
    in property <string> server-dialog-title;
    in-out property <string> form-name;
    in-out property <string> form-endpoint;
    in-out property <string> form-region;
    in-out property <string> form-access-key;
    in-out property <string> form-secret-key;
    in-out property <string> form-bucket;
    in-out property <bool> form-path-style;
    in property <string> form-message;
    callback save-server();
    callback test-server();

    // Image preview
    in-out property <bool> preview-open;
    in property <string> preview-title;
    in property <string> preview-info;
    in property <string> preview-message;
    in property <image> preview-image;

    // Confirm dialog
    in-out property <bool> confirm-open;
    in property <string> confirm-text;
    callback confirm-accepted();

    // New folder dialog
    in-out property <bool> newfolder-open;
    in-out property <string> newfolder-name;

    clipboard := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }

    HorizontalLayout {
        // Sidebar
        if root.sidebar-open: Rectangle {
            width: 230px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text {
                    text: "Servers";
                    font-weight: 700;
                }

                ListView {
                    vertical-stretch: 1;
                    for s[i] in root.servers: Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: i == root.selected-server ? Palette.selection-background : sta.has-hover ? Palette.control-background : transparent;
                        sta := TouchArea {
                            clicked => {
                                root.selected-server = i;
                            }
                            double-clicked => {
                                root.selected-server = i;
                                root.connect-server(i);
                            }
                        }

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            Text {
                                text: s.name;
                                overflow: elide;
                                color: i == root.selected-server ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: s.endpoint;
                                font-size: 11px;
                                overflow: elide;
                                opacity: 0.7;
                                color: i == root.selected-server ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                    }
                }

                Button {
                    text: "Connect";
                    icon: @image-url("icons/connect.svg");
                    colorize-icon: true;
                    primary: true;
                    enabled: root.selected-server >= 0;
                    clicked => {
                        root.connect-server(root.selected-server);
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    Button {
                        text: "Add";
                        icon: @image-url("icons/add.svg");
                        colorize-icon: true;
                        clicked => {
                            root.add-server();
                        }
                    }

                    Button {
                        text: "Edit";
                        icon: @image-url("icons/edit.svg");
                        colorize-icon: true;
                        enabled: root.selected-server >= 0;
                        clicked => {
                            root.edit-server(root.selected-server);
                        }
                    }

                    Button {
                        text: "Delete";
                        icon: @image-url("icons/trash.svg");
                        colorize-icon: true;
                        enabled: root.selected-server >= 0;
                        clicked => {
                            root.delete-server(root.selected-server);
                        }
                    }
                }
            }
        }

        // Handle that hides or shows the sidebar
        Rectangle {
            width: 14px;
            background: hta.has-hover ? Palette.control-background : Palette.alternate-background;
            Text {
                text: root.sidebar-open ? "‹" : "›";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 16px;
            }

            hta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.sidebar-open = !root.sidebar-open;
                }
            }
        }

        // Main area
        VerticalLayout {
            horizontal-stretch: 1;

            if root.active-tab < 0: Text {
                text: "Double-click a server to connect.\nEach connection opens in its own tab.";
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
                opacity: 0.6;
            }

            // Tab bar
            if root.active-tab >= 0: Rectangle {
                height: 34px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    alignment: start;
                    for t[i] in root.tabs: Rectangle {
                        background: i == root.active-tab ? Palette.background : tta.has-hover ? Palette.control-background : transparent;
                        tta := TouchArea {
                            clicked => {
                                root.select-tab(i);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 6px;
                            Text {
                                text: t;
                                vertical-alignment: center;
                                max-width: 170px;
                                overflow: elide;
                                font-weight: i == root.active-tab ? 600 : 400;
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: cta.has-hover ? #88888866 : transparent;
                                    Text {
                                        text: "×";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    cta := TouchArea {
                                        clicked => {
                                            root.close-tab(i);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Toolbar
            if root.active-tab >= 0: HorizontalLayout {
                padding: 6px;
                spacing: 6px;
                IconButton {
                    icon: @image-url("icons/up.svg");
                    tooltip: "Up";
                    enabled: root.in-bucket;
                    clicked => {
                        root.go-up();
                    }
                }

                IconButton {
                    icon: @image-url("icons/refresh.svg");
                    tooltip: "Refresh";
                    clicked => {
                        root.refresh();
                    }
                }

                Text {
                    text: root.location;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.search-open: Text {
                    text: root.search-info;
                    vertical-alignment: center;
                    opacity: 0.7;
                }

                if root.search-open: LineEdit {
                    width: 200px;
                    placeholder-text: "Search this folder";
                    text <=> root.search-text;
                    init => {
                        self.focus();
                    }
                    edited(text) => {
                        root.search-changed(text);
                    }
                }

                if root.search-open: IconButton {
                    icon: @image-url("icons/close.svg");
                    tooltip: "Close search";
                    clicked => {
                        root.search-open = false;
                        root.search-text = "";
                        root.search-changed("");
                    }
                }

                if !root.search-open: IconButton {
                    icon: @image-url("icons/search.svg");
                    tooltip: "Search";
                    clicked => {
                        root.search-open = true;
                    }
                }

                IconButton {
                    icon: @image-url("icons/upload.svg");
                    tooltip: "Upload";
                    enabled: root.in-bucket;
                    clicked => {
                        root.upload();
                    }
                }

                IconButton {
                    icon: @image-url("icons/download.svg");
                    tooltip: "Download";
                    enabled: root.in-bucket;
                    clicked => {
                        root.download();
                    }
                }

                IconButton {
                    icon: @image-url("icons/folder-plus.svg");
                    tooltip: "New Folder";
                    enabled: root.in-bucket;
                    clicked => {
                        root.newfolder-name = "";
                        root.newfolder-open = true;
                    }
                }

                IconButton {
                    icon: @image-url("icons/trash.svg");
                    tooltip: "Delete";
                    enabled: root.in-bucket;
                    clicked => {
                        root.delete-selected();
                    }
                }
            }

            // Column header
            if root.active-tab >= 0: Rectangle {
                height: 26px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 24px;
                    spacing: 8px;
                    Rectangle {
                        width: 16px;
                    }

                    HeaderCell {
                        title: "Name";
                        horizontal-stretch: 1;
                        active: root.sort-column == 0;
                        descending: root.sort-descending;
                        clicked => {
                            root.sort-by(0);
                        }
                    }

                    HeaderCell {
                        title: "Size";
                        width: 90px;
                        align-right: true;
                        active: root.sort-column == 1;
                        descending: root.sort-descending;
                        clicked => {
                            root.sort-by(1);
                        }
                    }

                    HeaderCell {
                        title: "Modified";
                        width: 140px;
                        active: root.sort-column == 2;
                        descending: root.sort-descending;
                        clicked => {
                            root.sort-by(2);
                        }
                    }
                }
            }

            if root.active-tab >= 0: ListView {
                vertical-stretch: 1;
                // Lazy loading: ask for the next page near the end of the list.
                changed content-y => {
                    if (root.has-more && !root.busy && self.visible-height - self.content-y >= self.content-height - 600px) {
                        root.load-more();
                    }
                }
                for entry[i] in root.entries: Rectangle {
                    height: 28px;
                    background: entry.selected ? Palette.selection-background : rta.has-hover ? Palette.alternate-background : transparent;
                    cma := ContextMenuArea {
                        Menu {
                            if entry.is-dir: MenuItem {
                                title: "Open";
                                activated => {
                                    root.row-activated(i);
                                }
                            }
                            if entry.is-image: MenuItem {
                                title: "Preview";
                                activated => {
                                    root.row-activated(i);
                                }
                            }
                            MenuItem {
                                title: "Copy Path";
                                activated => {
                                    root.copy-path(false);
                                }
                            }
                            MenuItem {
                                title: "Copy S3 URI";
                                activated => {
                                    root.copy-path(true);
                                }
                            }
                            MenuItem {
                                title: "Download";
                                enabled: root.in-bucket;
                                activated => {
                                    root.download();
                                }
                            }
                        }
                    }

                    rta := TouchArea {
                        property <bool> ctrl-down;
                        property <bool> dragged;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                self.ctrl-down = ev.modifiers.control;
                                self.dragged = false;
                                root.drag-active = false;
                                // A plain press keeps a selection that contains the
                                // row, so several rows can be dragged together.
                                if (ev.modifiers.control) {
                                    root.row-clicked(i, true);
                                } else {
                                    root.row-context(i);
                                }
                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                // Selects the row unless it is already part of the selection.
                                root.row-context(i);
                                cma.show({ x: self.mouse-x, y: self.mouse-y });
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                root.end-drag();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.drag-x = self.absolute-position.x + self.mouse-x;
                                root.drag-y = self.absolute-position.y + self.mouse-y;
                                if (!self.dragged && root.in-bucket && (abs((self.mouse-x - self.pressed-x) / 1px) > 8 || abs((self.mouse-y - self.pressed-y) / 1px) > 8)) {
                                    self.dragged = true;
                                    root.drag-from-local = false;
                                    root.drag-started(false);
                                    root.drag-active = true;
                                }
                            }
                        }
                        clicked => {
                            if (!self.ctrl-down && !self.dragged) {
                                root.row-clicked(i, false);
                            }
                        }
                        double-clicked => {
                            root.row-activated(i);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            EntryIcon {
                                is-dir: entry.is-dir;
                            }
                        }

                        Text {
                            text: entry.name;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                            color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: entry.size;
                            width: 90px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: entry.modified;
                            width: 140px;
                            vertical-alignment: center;
                            color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                        }
                    }
                }
            }

            // Status bar
            Rectangle {
                height: 28px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    if root.busy: VerticalLayout {
                        alignment: center;
                        Spinner {
                            width: 16px;
                            height: 16px;
                            indeterminate: true;
                        }
                    }
                    Text {
                        text: root.status;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.transfer-count > 0: Text {
                        text: root.transfer-text;
                        vertical-alignment: center;
                    }
                    if root.transfer-count > 0: VerticalLayout {
                        alignment: center;
                        ProgressIndicator {
                            width: 140px;
                            progress: root.transfer-progress;
                        }
                    }
                }
            }
        }

        // Handle that hides or shows the local pane
        Rectangle {
            width: 14px;
            background: lha.has-hover ? Palette.control-background : Palette.alternate-background;
            Text {
                text: root.local-open ? "›" : "‹";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 16px;
            }

            lha := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.local-open = !root.local-open;
                }
            }
        }

        // Local folder pane
        if root.local-open: Rectangle {
            width: root.local-width;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "Local";
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: @image-url("icons/up.svg");
                        tooltip: "Up";
                        clicked => {
                            root.local-up();
                        }
                    }

                    IconButton {
                        icon: @image-url("icons/refresh.svg");
                        tooltip: "Refresh";
                        clicked => {
                            root.local-refresh();
                        }
                    }

                    IconButton {
                        icon: @image-url("icons/folder.svg");
                        tooltip: "Choose folder";
                        clicked => {
                            root.local-choose();
                        }
                    }
                }

                Text {
                    text: root.local-path;
                    font-size: 11px;
                    overflow: elide;
                    opacity: 0.7;
                }

                ListView {
                    vertical-stretch: 1;
                    for entry[i] in root.local-entries: Rectangle {
                        height: 26px;
                        border-radius: 3px;
                        background: entry.selected ? Palette.selection-background : lta.has-hover ? Palette.control-background : transparent;
                        lta := TouchArea {
                            property <bool> ctrl-down;
                            property <bool> dragged;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                    self.ctrl-down = ev.modifiers.control;
                                    self.dragged = false;
                                    root.drag-active = false;
                                    if (ev.modifiers.control) {
                                        root.local-row-clicked(i, true);
                                    } else {
                                        root.local-row-context(i);
                                    }
                                } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                    root.end-drag();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-x = self.absolute-position.x + self.mouse-x;
                                    root.drag-y = self.absolute-position.y + self.mouse-y;
                                    if (!self.dragged && (abs((self.mouse-x - self.pressed-x) / 1px) > 8 || abs((self.mouse-y - self.pressed-y) / 1px) > 8)) {
                                        self.dragged = true;
                                        root.drag-from-local = true;
                                        root.drag-started(true);
                                        root.drag-active = true;
                                    }
                                }
                            }
                            clicked => {
                                if (!self.ctrl-down && !self.dragged) {
                                    root.local-row-clicked(i, false);
                                }
                            }
                            double-clicked => {
                                root.local-row-activated(i);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                EntryIcon {
                                    is-dir: entry.is-dir;
                                }
                            }

                            Text {
                                text: entry.name;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: entry.size;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: entry.selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                    }
                }

                Text {
                    text: root.local-status;
                    font-size: 11px;
                    overflow: elide;
                    opacity: 0.7;
                }
            }
        }
    }

    // Drop target highlight while dragging
    if root.over-local || root.over-remote: Rectangle {
        x: root.over-local ? root.width - root.local-width : root.main-left;
        y: 0px;
        width: root.over-local ? root.local-width : root.local-left - root.main-left;
        height: root.height;
        border-width: 2px;
        border-color: Palette.accent-background;
        background: #4080ff22;
    }

    if root.preview-open: Rectangle {
        background: #000000e0;

        // Click anywhere to close.
        TouchArea {
            clicked => {
                root.preview-open = false;
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.preview-title;
                    color: white;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.preview-info;
                    color: #cccccc;
                    vertical-alignment: center;
                }

                Button {
                    text: "Close";
                    icon: @image-url("icons/close.svg");
                    colorize-icon: true;
                    clicked => {
                        root.preview-open = false;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // Shown at natural size, scaled down only when it does not fit.
                Image {
                    source: root.preview-image;
                    image-fit: contain;
                    width: min(parent.width, self.source.width * 1px);
                    height: min(parent.height, self.source.height * 1px);
                }

                Text {
                    text: root.preview-message;
                    color: white;
                    wrap: word-wrap;
                    width: min(parent.width, 520px);
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.server-dialog-open: Modal {
        title: root.server-dialog-title;
        box-width: 480px;
        Field {
            label: "Name";
            value <=> root.form-name;
        }

        Field {
            label: "Endpoint URL";
            hint: "https://… (blank for AWS)";
            value <=> root.form-endpoint;
        }

        Field {
            label: "Region";
            hint: "us-east-1";
            value <=> root.form-region;
        }

        Field {
            label: "Access key";
            value <=> root.form-access-key;
        }

        Field {
            label: "Secret key";
            secret: true;
            value <=> root.form-secret-key;
        }

        Field {
            label: "Default bucket";
            hint: "optional";
            value <=> root.form-bucket;
        }

        CheckBox {
            text: "Path-style addressing (MinIO, Ceph)";
            checked <=> root.form-path-style;
        }

        Text {
            text: root.form-message;
            wrap: word-wrap;
            min-height: 32px;
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: "Test Connection";
                icon: @image-url("icons/pulse.svg");
                colorize-icon: true;
                clicked => {
                    root.test-server();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.server-dialog-open = false;
                }
            }

            Button {
                text: "Save";
                icon: @image-url("icons/check.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    root.save-server();
                }
            }
        }
    }

    if root.newfolder-open: Modal {
        title: "New folder";
        box-width: 380px;
        LineEdit {
            text <=> root.newfolder-name;
            placeholder-text: "Folder name";
            accepted => {
                root.newfolder-open = false;
                root.create-folder(root.newfolder-name);
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.newfolder-open = false;
                }
            }

            Button {
                text: "Create";
                icon: @image-url("icons/folder-plus.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    root.newfolder-open = false;
                    root.create-folder(root.newfolder-name);
                }
            }
        }
    }

    if root.confirm-open: Modal {
        title: "Confirm delete";
        box-width: 420px;
        Text {
            text: root.confirm-text;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button {
                text: "Cancel";
                icon: @image-url("icons/close.svg");
                colorize-icon: true;
                clicked => {
                    root.confirm-open = false;
                }
            }

            Button {
                text: "Delete";
                icon: @image-url("icons/trash.svg");
                colorize-icon: true;
                primary: true;
                clicked => {
                    root.confirm-open = false;
                    root.confirm-accepted();
                }
            }
        }
    }

    if root.drag-active: Rectangle {
        x: min(root.width - self.width - 4px, root.drag-x + 14px);
        y: min(root.height - self.height - 4px, root.drag-y + 14px);
        width: drag-text.preferred-width + 16px;
        height: drag-text.preferred-height + 8px;
        border-radius: 4px;
        background: Palette.accent-background;
        drag-text := Text {
            text: root.drag-label;
            color: Palette.accent-foreground;
        }
    }

    if Tip.text != "": Rectangle {
        x: max(4px, min(root.width - self.width - 4px, Tip.x - self.width / 2));
        y: Tip.y;
        width: tip-text.preferred-width + 16px;
        height: tip-text.preferred-height + 8px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.alternate-background;
        tip-text := Text {
            text: Tip.text;
            color: Palette.foreground;
        }
    }
}
